# Frontend API base URL. Override only when using a different API deployment.
VITE_API_BASE_URL=https://neurosql-api.onrender.com

# Keep false until the backend owner auth and schema-browser flags are deliberately enabled.
VITE_SCHEMA_LOGIN_ENABLED=false

# Keep false until the durable-auth schema is approved and backend grants are configured.
VITE_DURABLE_AUTH_ENABLED=false

# Keep false until the backend SQL execution flag and a restricted read-only database login are verified.
VITE_SQL_EXECUTION_ENABLED=false

# Keep false until durable auth, shared throttling, and the backend AI provider are securely configured.
VITE_AI_SQL_GENERATION_ENABLED=false
